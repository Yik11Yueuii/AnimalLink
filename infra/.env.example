# Copy to infra/.env, then replace every example secret before starting Compose.
MYSQL_ROOT_PASSWORD=ReplaceLocalRootPassword123
MYSQL_PORT=3308
IDENTITY_DB_PASSWORD=ReplaceIdentityPassword123
ANIMAL_DB_PASSWORD=ReplaceAnimalPassword123
INCIDENT_DB_PASSWORD=ReplaceIncidentPassword123
ADOPTION_DB_PASSWORD=ReplaceAdoptionPassword123
INTELLIGENCE_DB_PASSWORD=ReplaceIntelligencePassword123
MINIO_ACCESS_KEY=ReplaceLocalMinioUser
MINIO_SECRET_KEY=ReplaceLocalMinioPassword123
# Phase 2A defaults to the deterministic local mock. Set a real key only in infra/.env.
AI_PROVIDER=mock
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL_NAME=local-observation-mock
AI_CONNECT_TIMEOUT_MS=3000
AI_READ_TIMEOUT_MS=20000
# Phase 2B 默认使用确定性的图像 Embedding mock。真实供应商必须明确支持图像输入。
EMBEDDING_PROVIDER=mock
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL_NAME=local-image-embedding-mock
EMBEDDING_MODEL_VERSION=v1
EMBEDDING_CONNECT_TIMEOUT_MS=3000
EMBEDDING_READ_TIMEOUT_MS=15000
MATCHING_RECALL_LIMIT=50
MATCHING_WEIGHT_A_IMAGE=1.0
MATCHING_WEIGHT_A_TRAIT=0.0
MATCHING_WEIGHT_A_GEO=0.0
MATCHING_WEIGHT_A_HISTORY=0.0
MATCHING_WEIGHT_B_IMAGE=0.65
MATCHING_WEIGHT_B_TRAIT=0.35
MATCHING_WEIGHT_B_GEO=0.0
MATCHING_WEIGHT_B_HISTORY=0.0
MATCHING_WEIGHT_C_IMAGE=0.55
MATCHING_WEIGHT_C_TRAIT=0.30
MATCHING_WEIGHT_C_GEO=0.15
MATCHING_WEIGHT_C_HISTORY=0.0
MATCHING_WEIGHT_D_IMAGE=0.50
MATCHING_WEIGHT_D_TRAIT=0.30
MATCHING_WEIGHT_D_GEO=0.12
MATCHING_WEIGHT_D_HISTORY=0.08
