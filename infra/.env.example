# Copy to infra/.env, then replace every example secret before starting Compose.
MYSQL_ROOT_PASSWORD=ReplaceLocalRootPassword123
MYSQL_PORT=3308
IDENTITY_DB_PASSWORD=ReplaceIdentityPassword123
ANIMAL_DB_PASSWORD=ReplaceAnimalPassword123
INCIDENT_DB_PASSWORD=ReplaceIncidentPassword123
ADOPTION_DB_PASSWORD=ReplaceAdoptionPassword123
INTELLIGENCE_DB_PASSWORD=ReplaceIntelligencePassword123
MINIO_ACCESS_KEY=ReplaceLocalMinioUser
MINIO_SECRET_KEY=ReplaceLocalMinioPassword123
# Phase 2A defaults to the deterministic local mock. Set a real key only in infra/.env.
AI_PROVIDER=mock
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL_NAME=local-observation-mock
AI_CONNECT_TIMEOUT_MS=3000
AI_READ_TIMEOUT_MS=20000
