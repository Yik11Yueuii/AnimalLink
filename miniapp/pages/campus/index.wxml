<view class="page-shell">
  <view wx:if="{{offline}}" class="mode-banner">本地离线演示 · 数据不会发送到后端</view>
  <view class="intro">
    <text class="eyebrow">CAMPUS CONTEXT</text>
    <text class="page-title">选择高校</text>
    <text class="muted intro-copy">选择已开放的高校进入统一社区。切换浏览范围不会授予校园成员身份。</text>
  </view>

  <view class="filters surface">
    <view class="search-row">
      <view class="search-field">
        <input class="university-search-input" value="{{q}}" placeholder="搜索全国高校" placeholder-class="search-placeholder" aria-label="搜索全国高校名称、城市或学校识别码" confirm-type="search" bindinput="onKeywordInput" bindconfirm="onSearch" maxlength="80" />
      </view>
      <button size="mini" class="secondary-button search-button" bindtap="onSearch">搜索</button>
      <view class="province-entry">
        <button size="mini" class="province-button" bindtap="openProvincePicker" aria-expanded="{{provincePickerOpen}}" aria-label="按省找校，打开省份和高校选择器">按省找校⌄</button>
      </view>
    </view>
    <text class="search-hint">支持高校名称、城市或完整学校识别码</text>
  </view>

  <view class="result-meta"><text>{{searchTerm ? '全国搜索结果' : '高校目录 · 全国范围'}}</text><text>{{universityTotal}} 所高校</text></view>
  <view wx:if="{{selectionError && !provincePickerOpen}}" class="selection-error" role="alert">{{selectionError}}</view>
  <view wx:if="{{loading}}" class="state-card surface"><text class="state-icon">⌛</text><text class="state-title">正在读取高校目录</text></view>
  <view wx:elif="{{errorMessage && universities.length === 0}}" class="state-card surface"><text class="state-icon">!</text><text class="state-title">加载失败</text><text class="state-copy">{{errorMessage}}</text><button class="primary-button" bindtap="onRetry">重试</button></view>
  <view wx:elif="{{universities.length === 0}}" class="state-card surface"><text class="state-icon">⌕</text><text class="state-title">没有匹配的高校</text><text class="state-copy">试试其他名称、城市或完整学校识别码。目录将随社区建设逐步扩充。</text></view>
  <view wx:else class="university-list">
    <view wx:for="{{universities}}" wx:key="id" class="university surface {{item.id === selectedUniversityId ? 'current' : ''}} {{item.communityAvailable ? '' : 'unavailable'}}" data-id="{{item.id}}" bindtap="chooseUniversity" aria-disabled="{{!item.communityAvailable || !!openingUniversityId}}">
      <view class="university-main">
        <view class="university-title-row"><text class="university-name">{{item.officialName}}</text><text class="availability {{item.communityAvailable ? 'open' : 'closed'}}">{{item.communityAvailable ? '社区已开放' : '社区尚未开放'}}</text></view>
        <text class="university-location">{{item.province}} · {{item.city}}</text>
        <text class="institution-code">学校识别码 {{item.moeInstitutionCode}}</text>
      </view>
      <text class="choose {{item.communityAvailable ? '' : 'choose-disabled'}}">{{!item.communityAvailable ? '暂不可进入' : openingUniversityId === item.id ? '进入中…' : item.id === selectedUniversityId ? '当前学校' : '进入社区 ›'}}</text>
    </view>
    <view wx:if="{{errorMessage}}" class="selection-error" role="alert"><text>{{errorMessage}}</text><button class="load-more" bindtap="onRetry">重试加载</button></view>
    <button wx:elif="{{hasMoreUniversities}}" class="load-more" loading="{{loadingMore}}" disabled="{{loadingMore}}" bindtap="loadMoreUniversities">加载更多高校</button>
  </view>

  <view wx:if="{{provincePickerOpen}}" class="province-overlay" bindtap="closeProvincePicker" catchtouchmove="stopPropagation">
    <view class="province-panel" catchtap="stopPropagation" role="dialog" aria-label="按省找校">
      <view class="panel-header"><view><text class="panel-title">按省找校</text><text class="panel-hint">仅已开放社区可以进入</text></view><button class="close-button" bindtap="closeProvincePicker" aria-label="关闭按省找校">关闭</button></view>
      <view class="cascade">
        <scroll-view class="province-column" scroll-y enhanced show-scrollbar="{{false}}">
          <view wx:for="{{provinceOptions}}" wx:key="*this" class="province-option {{item === activeProvince ? 'active' : ''}}" data-province="{{item}}" bindtap="onProvinceTap">{{item}}</view>
        </scroll-view>
        <view class="school-column">
          <view class="province-meta">{{activeProvince}} · {{provinceLoading ? '读取中' : provinceTotal + ' 所高校'}}</view>
          <scroll-view class="school-scroll" scroll-y enhanced show-scrollbar="{{false}}" scroll-top="{{provinceScrollTop}}" bindscrolltolower="loadMoreProvinceUniversities" lower-threshold="60">
            <view wx:if="{{provinceLoading}}" class="panel-state">正在读取高校…</view>
            <view wx:elif="{{provinceError && provinceUniversities.length === 0}}" class="panel-state"><text>{{provinceError}}</text><button class="load-more" bindtap="retryProvince">重试</button></view>
            <view wx:elif="{{provinceUniversities.length === 0}}" class="panel-state">该地区暂无已录入高校，可使用全国搜索查找。</view>
            <block wx:else>
              <view wx:for="{{provinceUniversities}}" wx:key="id" class="school-option {{item.communityAvailable ? '' : 'unavailable'}}" data-id="{{item.id}}" data-source="province" bindtap="chooseUniversity" aria-disabled="{{!item.communityAvailable || !!openingUniversityId}}">
                <text class="school-name">{{item.officialName}}</text>
                <text class="university-location">{{item.city}}</text>
                <text class="availability {{item.communityAvailable ? 'open' : 'closed'}}">{{openingUniversityId === item.id ? '进入中…' : item.communityAvailable ? '社区已开放 ›' : '社区尚未开放'}}</text>
              </view>
              <view wx:if="{{provinceError}}" class="panel-state" role="alert"><text>{{provinceError}}</text><button class="load-more" bindtap="retryProvince">重试加载</button></view>
              <button wx:elif="{{provinceHasMore}}" class="load-more" loading="{{provinceLoadingMore}}" disabled="{{provinceLoadingMore}}" bindtap="loadMoreProvinceUniversities">加载更多</button>
              <view wx:else class="list-end">已显示该地区全部已录入高校</view>
            </block>
          </scroll-view>
        </view>
      </view>
      <view wx:if="{{selectionError}}" class="panel-error" role="alert">{{selectionError}}</view>
    </view>
  </view>
</view>
