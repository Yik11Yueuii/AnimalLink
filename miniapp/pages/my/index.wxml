<view class="page-shell">
  <view class="profile surface">
    <view class="avatar">AL</view>
    <text class="page-title">My</text>
    <block wx:if="{{user}}">
      <text class="profile-copy">{{user.displayName}}</text>
      <view class="boundary">普通用户已登录；校园成员身份需经人工审核，不会自动授予。</view>
      <view class="identity-panel" wx:if="{{identity}}">
        <text class="section-title">校园身份</text>
        <block wx:if="{{identity.memberships.length}}">
          <text class="identity-group-title">已有校园成员身份</text>
          <view class="identity-row" wx:for="{{identity.memberships}}" wx:key="id">
            <text>{{item.campus.name}} · {{item.membershipType}}</text>
            <text class="{{item.status === 'ACTIVE' ? 'status-active' : 'status-inactive'}}">{{item.status === 'ACTIVE' ? '有效成员身份' : item.status}}</text>
          </view>
        </block>
        <block wx:if="{{identity.applications.length}}">
          <text class="identity-group-title">校园身份申请记录</text>
          <view class="identity-row" wx:for="{{identity.applications}}" wx:key="id">
            <text>{{item.campus.name}} · {{item.requestedMembershipType}}</text><text class="status-pending">{{item.status}}</text>
            <text wx:if="{{item.reviewReason}}" class="review-reason">审核说明：{{item.reviewReason}}</text>
          </view>
        </block>
        <view wx:if="{{!identity.memberships.length && !identity.applications.length}}" class="identity-empty">尚未提交校园身份申请。</view>
        <button class="quiet-button" bindtap="openIdentityForm">申请校园身份</button>
      </view>
      <view wx:if="{{showIdentityForm}}" class="identity-form">
        <text class="section-title">提交身份申请</text>
        <picker range="{{campuses}}" range-key="name" value="{{campusIndex}}" bindchange="campusChange"><view class="picker-field">选择校园：{{selectedCampusName}}</view></picker>
        <picker range="{{membershipTypes}}" value="{{membershipTypeIndex}}" bindchange="membershipTypeChange"><view class="picker-field">身份类型：{{membershipTypes[membershipTypeIndex]}}</view></picker>
        <input class="form-input" data-field="applicantName" value="{{form.applicantName}}" bindinput="formInput" placeholder="真实姓名" maxlength="80" />
        <input class="form-input" data-field="affiliationNote" value="{{form.affiliationNote}}" bindinput="formInput" placeholder="院系或校友说明（可选）" maxlength="255" />
        <picker mode="date" bindchange="formInput" data-field="expectedGraduationDate"><view class="picker-field">预计毕业日期（学生可选）：{{form.expectedGraduationDate || '未填写'}}</view></picker>
        <button class="login-button" loading="{{loading}}" bindtap="submitIdentity">提交人工审核</button>
        <button class="quiet-button" bindtap="closeIdentityForm">取消</button>
        <text class="demo-copy">本阶段不上传学籍材料；提交不会自动获得校园成员身份。</text>
      </view>
      <button class="quiet-button" loading="{{loading}}" bindtap="logout">退出登录</button>
    </block>
    <block wx:else>
      <text class="profile-copy">登录后可安全使用后续个人服务；公开浏览无需登录。</text>
      <button class="login-button" loading="{{loading}}" bindtap="login">微信登录</button>
      <view class="boundary">不会自动获取手机号、头像昵称，也不会虚构校园成员或志愿者身份。</view>
    </block>
    <text wx:if="{{error}}" class="error-copy">{{error}}</text>
    <button wx:if="{{user && error && !loading}}" class="retry-button" bindtap="retryCampusIdentity">重试身份查询</button>
    <text wx:if="{{offline}}" class="demo-copy">本地演示模式 · 未启用真实微信登录</text>
  </view>
</view>
