<view class="page-shell"><view class="surface panel"><text>全站公开领养信息，不按当前 Campus 筛选。</text><text wx:if="{{offline}}">当前为离线演示，不能提交真实申请。</text></view>
<block wx:if="{{!selected}}"><view wx:for="{{items}}" wx:key="listingId" class="surface panel" data-id="{{item.listingId}}" bindtap="open"><text>{{item.title}}</text><view>{{item.description}}</view></view><view wx:if="{{!loading && !items.length}}">暂无公开领养信息</view><view wx:if="{{error}}">{{error}} <button bindtap="refresh">重试</button></view><button wx:if="{{items.length < total}}" bindtap="more" disabled="{{loading}}">加载更多</button></block>
<view wx:else class="surface panel"><button bindtap="back">返回列表</button><view>{{selected.title}}</view><view>{{selected.description}}</view><view>关联动物：{{animalName || '正在读取公开档案'}}</view><button wx:if="{{animalAvailable}}" bindtap="animal">查看公开动物档案</button><textarea maxlength="2000" value="{{input}}" bindinput="inputChanged" placeholder="填写申请说明" /><button bindtap="submit" loading="{{submitBusy}}" disabled="{{submitBusy || uncertain}}">确认申请</button><view wx:if="{{message}}">{{message}}</view><view wx:if="{{existing}}">{{existingText}} <text wx:if="{{existing.selected}}">· 已被选定，尚需完成交接</text></view><button wx:if="{{uncertain}}" bindtap="checkExisting">查询申请状态</button><button bindtap="myApplications">我的领养申请</button></view></view>
