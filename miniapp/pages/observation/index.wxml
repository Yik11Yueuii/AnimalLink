<view class="page-shell"><view class="surface card"><text>动物观察 · {{campusName || '未选择高校'}}</text><view>选择真实图片，AI 结果需人工检查；不会自动建立动物身份。</view><button bindtap="choose" disabled="{{busy}}">选择图片</button><view>{{imagePath ? '已选择图片' : '未选择图片'}}</view><textarea placeholder="观察描述" value="{{text}}" bindinput="textChanged" /><input placeholder="观察地点（可选）" value="{{location}}" bindinput="locationChanged" /><button bindtap="parse" disabled="{{busy}}">AI 解析</button><button bindtap="manual" disabled="{{busy}}">手工录入</button><view wx:if="{{error}}">{{error}}</view><view wx:if="{{message}}">{{message}}</view></view><view wx:if="{{draft}}" class="surface card"><view>任务状态：{{task.status}}</view><picker range="{{speciesOptions}}" value="{{speciesIndex}}" bindchange="speciesChanged"><view>物种：{{draft.species}}</view></picker><picker range="{{sexOptions}}" value="{{sexIndex}}" bindchange="sexChanged"><view>性别：{{draft.sex}}</view></picker><input value="{{draft.coatColor}}" bindinput="colorChanged" placeholder="毛色" /><textarea value="{{draft.behavior}}" bindinput="behaviorChanged" placeholder="行为" /><textarea value="{{draft.visibleCondition}}" bindinput="conditionChanged" placeholder="可见状态" /><view>其他结构化字段（可编辑）</view><textarea value="{{draftJson}}" bindinput="jsonChanged" maxlength="-1" /><button bindtap="refresh" disabled="{{busy}}">刷新任务状态</button><button wx:if="{{!task.confirmedAt}}" bindtap="confirm" disabled="{{busy}}">确认观察草稿</button></view></view>