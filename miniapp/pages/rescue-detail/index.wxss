.hero, .section { padding: 30rpx; }.status-row { display: flex; align-items: center; justify-content: space-between; margin-top: 22rpx; }.status { padding: 7rpx 14rpx; border-radius: 999rpx; font-size: 22rpx; }.status-WAITING_CLAIM { color: #9a543d; background: #fff0e9; }.status-IN_PROGRESS { color: #427967; background: #eaf6f1; }.status-RESOLVED { color: #6473a1; background: #eef0fa; }.status-CLOSED { color: #5d7968; background: #eef5ed; }.status-CLOSED_UNRESOLVED, .status-CANCELLED { color: #80685d; background: #f3eee9; }.summary { display: block; margin-top: 28rpx; color: #4f382c; font-size: 30rpx; line-height: 1.8; }.animal-card { display: flex; align-items: center; margin-top: 24rpx; padding: 18rpx; background: #eef8f3; }.animal-card image { width: 92rpx; height: 92rpx; border-radius: 20rpx; }.animal-card view { flex: 1; min-width: 0; padding-left: 18rpx; }.animal-card text { display: block; }.animal-title { font-size: 28rpx; font-weight: 800; }.animal-copy { margin-top: 8rpx; color: #668679; font-size: 22rpx; }.arrow { color: #71a290; font-size: 40rpx; }.section { margin-top: 24rpx; }.section-title { display: block; margin-bottom: 24rpx; font-size: 30rpx; font-weight: 800; }.timeline-item { display: flex; gap: 22rpx; min-height: 110rpx; }.dot { flex: 0 0 auto; margin-top: 8rpx; width: 18rpx; height: 18rpx; border: 7rpx solid #e6f3ee; border-radius: 50%; background: #66a58f; }.progress-label, .progress-time { display: block; }.progress-label { font-size: 27rpx; font-weight: 700; }.progress-time { margin-top: 8rpx; color: #8f796e; font-size: 22rpx; }.empty { padding: 30rpx 0; color: #927c70; text-align: center; font-size: 24rpx; }.notice { margin-top: 24rpx; padding: 22rpx; color: #80685d; border-radius: 20rpx; background: #fbf4ed; font-size: 23rpx; line-height: 1.65; }
