<view class="page-shell"><view class="surface panel"><text>申请进度</text><view>审核通过或被选定均不代表已完成领养交接。</view></view><view wx:if="{{error}}">{{error}}<button bindtap="refresh">重试</button></view><view wx:if="{{message}}">{{message}}</view><block wx:if="{{!selected}}"><view wx:for="{{items}}" wx:key="applicationId" class="surface panel" data-id="{{item.applicationId}}" bindtap="open"><view>{{item.statusText}}</view><view>申请时间：{{item.createdAt}}</view><view wx:if="{{item.selected}}">已被选定，交接结果需另行确认</view><view>查看详情 ›</view></view><view wx:if="{{!loading && !error && !items.length}}">暂无申请记录</view><button wx:if="{{items.length < total}}" bindtap="more" disabled="{{loading}}">加载更多</button></block><view wx:else class="surface panel"><button bindtap="back">返回申请列表</button><view>{{selected.statusText}}</view><view wx:if="{{selected.selected}}">已被选定，交接结果需另行确认</view><view>{{selected.message}}</view><view wx:if="{{selected.reviewComment}}">审核说明：{{selected.reviewComment}}</view><button wx:if="{{selected.status === 'SUBMITTED'}}" bindtap="withdraw" disabled="{{loading}}">申请撤回</button></view></view>
