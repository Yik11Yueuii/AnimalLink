.heading { display: flex; align-items: flex-start; justify-content: space-between; }.heading text { display: block; }.campus-button { margin: 2rpx 0 0 20rpx; padding: 0 22rpx; min-width: 170rpx; color: #4f7468; border: 1rpx solid #b8d8cc; border-radius: 22rpx; background: #eff8f4; font-size: 24rpx; }.intro { margin-top: 28rpx; padding: 24rpx 28rpx; color: #6f5a50; font-size: 25rpx; line-height: 1.65; }.status-picker { margin-top: 18rpx; padding: 20rpx 24rpx; color: #527b6c; border-radius: 20rpx; background: #f1f8f5; font-size: 25rpx; font-weight: 700; }.result-meta, .card-top { display: flex; justify-content: space-between; }.result-meta { padding: 24rpx 4rpx 12rpx; color: #8b7468; font-size: 24rpx; }.rescue-card { margin-bottom: 20rpx; padding: 28rpx; }.rescue-card:active { transform: scale(.995); background: #fff9f5; }.status { padding: 7rpx 14rpx; border-radius: 999rpx; font-size: 21rpx; }.status-WAITING_CLAIM { color: #9a543d; background: #fff0e9; }.status-IN_PROGRESS { color: #427967; background: #eaf6f1; }.status-RESOLVED { color: #6473a1; background: #eef0fa; }.status-CLOSED { color: #5d7968; background: #eef5ed; }.status-CLOSED_UNRESOLVED, .status-CANCELLED { color: #80685d; background: #f3eee9; }.time { color: #9a857a; font-size: 21rpx; }.summary { display: block; margin-top: 22rpx; color: #4f382c; font-size: 28rpx; line-height: 1.7; }.animal-row { display: flex; gap: 12rpx; align-items: center; margin-top: 18rpx; color: #4f7468; font-size: 23rpx; }.animal-badge { padding: 5rpx 10rpx; border-radius: 10rpx; background: #eaf6f1; font-size: 20rpx; }.detail-link { display: block; margin-top: 22rpx; padding-top: 18rpx; color: #d76545; border-top: 1rpx solid #f0e7e0; font-size: 23rpx; font-weight: 700; }.inline-error { display: flex; justify-content: space-between; margin: 10rpx 0 18rpx; padding: 20rpx; color: #a45438; border-radius: 18rpx; background: #fff0e9; font-size: 23rpx; }.retry-link { font-weight: 700; }.load-more { color: #8b4a34; border-radius: 22rpx; background: #fff0e9; font-size: 26rpx; }.list-end { display: block; padding: 26rpx; color: #9a857a; text-align: center; font-size: 23rpx; }
