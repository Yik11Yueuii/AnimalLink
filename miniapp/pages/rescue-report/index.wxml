<view class="page-shell"><view class="heading"><text class="eyebrow">RESCUE REPORT</text><text class="page-title">上报校园救助</text><text class="campus-copy">{{campus ? campus.name : '未选择高校'}}</text></view><view wx:if="{{submittedEventId}}" class="success surface"><text class="section-title">已提交救助事件</text><text>{{notice}}</text></view><view wx:else class="surface form"><text class="hint">仅处理人员保留精确位置；公开救助页面不会展示上报人、精确位置或草稿内容。</text><textarea data-field="description" value="{{form.description}}" bindinput="formInput" placeholder="请描述观察到的异常情况" maxlength="2000"/><input data-field="publicLocationDescription" value="{{form.publicLocationDescription}}" bindinput="formInput" placeholder="公开位置描述（不填写宿舍、房间等精确位置）" maxlength="500"/><input data-field="exactLocationDescription" value="{{form.exactLocationDescription}}" bindinput="formInput" placeholder="精确位置（仅处理人员可见，可选）" maxlength="1000"/><input data-field="abnormalitySummary" value="{{form.abnormalitySummary}}" bindinput="formInput" placeholder="异常摘要（可选）" maxlength="1000"/><button class="quiet-button" loading="{{loading}}" bindtap="saveDraft">保存草稿</button><button class="primary-button" loading="{{loading}}" disabled="{{!draftId || loading}}" bindtap="submit">确认提交</button></view><text wx:if="{{notice && !submittedEventId}}" class="notice">{{notice}}</text><text wx:if="{{error}}" class="error-copy">{{error}}</text></view>
