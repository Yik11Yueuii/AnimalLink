# Browser requests stay same-origin. Leave the public base URL empty when using the Vite proxy.
VITE_GATEWAY_API_BASE_URL=
VITE_GATEWAY_API_TIMEOUT_MS=10000

# Local files generated by a trusted local CA such as mkcert. Never commit private keys or certificates.
GOVERNANCE_DEV_HTTPS_KEY_FILE=C:/absolute/path/to/localhost-key.pem
GOVERNANCE_DEV_HTTPS_CERT_FILE=C:/absolute/path/to/localhost.pem
GOVERNANCE_DEV_HTTPS_HOST=localhost
GOVERNANCE_DEV_HTTPS_PORT=5173

# Server-side Vite proxy target. The browser never calls this origin directly.
GOVERNANCE_GATEWAY_TARGET=http://127.0.0.1:8080

# Configure Gateway separately with:
# AUTH_ADMIN_ALLOWED_ORIGINS=https://localhost:5173
